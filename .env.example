# Copia este archivo como .env.local y rellena los valores.
# .env.local nunca se sube al repositorio.

# ── Sitio ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://nexxodesign.com
# "true" saca el sitio de Google. Debe estar vacío o en false en producción.
NEXT_PUBLIC_NOINDEX=

# ── Sanity (CMS) ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Token con permiso de escritura. Lo usan la automatización de YouTube y el
# webhook de la tienda (para no procesar dos veces el mismo pedido).
SANITY_API_WRITE_TOKEN=

# ── Correo (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@nexxodesign.com
RESEND_TO_EMAIL=info@nexxodesign.com
# Audiencia para la lista de lanzamientos. Opcional: sin ella, igual te llega
# el correo de cada interesado.
RESEND_AUDIENCE_ID=
# A dónde llegan los avisos de la tienda. Si está vacío, usa RESEND_TO_EMAIL.
NOTIFY_EMAIL=

# ── Tienda (Lemon Squeezy) ───────────────────────────────────────────────────
# Secreto del webhook, tal como lo creaste en Lemon Squeezy → Settings → Webhooks.
# Sin esto, /api/lemonsqueezy/webhook rechaza todo.
LEMONSQUEEZY_WEBHOOK_SECRET=
# API key para validar licencias (fase 2). Nunca la pongas en un componente de
# Framer: el navegador la deja a la vista.
LEMONSQUEEZY_API_KEY=
# Dominios extra que pueden validar licencias, separados por coma. Los de Framer
# ya están permitidos.
LICENSE_ALLOWED_ORIGINS=

# ── Automatización de YouTube → Journal ──────────────────────────────────────
CRON_SECRET=
ANTHROPIC_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Lo genera scripts/youtube-auth.mjs una sola vez.
YOUTUBE_REFRESH_TOKEN=
