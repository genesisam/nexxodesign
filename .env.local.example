# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit actual secrets.

# ─── Site ───
# Canonical origin, no trailing slash. Everything SEO-facing derives from this:
# canonical tags, hreflang, sitemap, robots and JSON-LD. Must match the real
# domain in production or every one of those points at the wrong host.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Soft launch: `1` keeps the site reachable but blocks crawlers (robots.txt +
# meta robots + X-Robots-Tag). Set to `0` or remove it to go live.
NEXT_PUBLIC_NOINDEX=1

# ─── Email (contact form) ───
RESEND_API_KEY=your_resend_key_here
RESEND_TO_EMAIL=you@your-domain.com
RESEND_FROM_EMAIL=noreply@your-domain.com

# ─── Sanity ───
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=your_read_token_here

# ─── Mux (showreel / heavy video) ───
MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret
NEXT_PUBLIC_MUX_PLAYBACK_ID=your_mux_playback_id

# ─── Analytics ───
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
